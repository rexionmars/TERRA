% =====================================================================
% terra.sty — identidade dos documentos da linha TERRA-Simulation
%
%   \usepackage{terra}
%
% Extrai o que ja se repetia nos .tex da linha (cores, \campo, aviso,
% objecao) e acrescenta a capa. Nao inventa estilo novo: os documentos
% existentes continuam com a mesma cara depois de migrar para ca.
%
% Serve `article` e `report`/`book` -- o formato de capitulo so e instalado
% quando a classe tem `\chapter`, de modo que os estudos em `article` nao
% mudam de aparencia.
%
% Opcoes:
%   [semcapa]   nao carrega tikz/eso-pic (documento curto, sem capa)
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{terra}[2026/08/22 Identidade TERRA-Simulation]

\newif\ifterra@capa \terra@capatrue
\DeclareOption{semcapa}{\terra@capafalse}

% Familia tipografica. Serifada no corpo e sem serifa nos titulos: texto
% corrido longo -- e os documentos desta linha sao longos -- cansa menos em
% serifada, e o contraste marca a hierarquia sem precisar de regua nem cor.
\def\terra@fonte{plex}
\DeclareOption{plex}{\def\terra@fonte{plex}}
\DeclareOption{source}{\def\terra@fonte{source}}
\DeclareOption{libertinus}{\def\terra@fonte{libertinus}}
\DeclareOption{padrao}{\def\terra@fonte{padrao}}
\ProcessOptions\relax

\def\terra@plex{plex}\def\terra@source{source}
\def\terra@libertinus{libertinus}
\ifx\terra@fonte\terra@plex
  \RequirePackage{plex-serif}
  \RequirePackage[scale=.96]{plex-sans}
  \RequirePackage[scale=.92]{plex-mono}
\else\ifx\terra@fonte\terra@source
  \RequirePackage{sourceserifpro}
  \RequirePackage[scale=.95]{sourcesanspro}
  \RequirePackage[scale=.92]{sourcecodepro}
\else\ifx\terra@fonte\terra@libertinus
  % A familia libertinus ja traz serifada, sem serifa e monoespacada
  % combinadas. Somar `inter` aqui fazia o corpo virar sem serifa.
  \RequirePackage{libertinus}
\fi\fi\fi

% Titulos sem serifa, corpo serifado -- em todas as variantes. Sem isto o
% `source` herdava titulo serifado e a hierarquia sumia: a diferenca entre
% titulo e corpo passava a ser so o corpo da fonte, que a olho nu quase nao
% separa.
\RequirePackage{titlesec}
\titleformat{\section}{\sffamily\large\bfseries}{\thesection}{.7em}{}
\titleformat{\subsection}{\sffamily\normalsize\bfseries}{\thesubsection}{.6em}{}
\titleformat{\subsubsection}{\sffamily\small\bfseries}{\thesubsubsection}{.6em}{}
\titlespacing*{\section}{0pt}{1.5em}{.6em}
\titlespacing*{\subsection}{0pt}{1.1em}{.45em}

\RequirePackage{xcolor}
\RequirePackage{graphicx}
\RequirePackage{caption}
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{enumitem}
\RequirePackage{amsmath,amssymb}
% natbib: os estudos citam com \citet/\citep e trazem `thebibliography`
% escrita a mao. Carregado aqui para que o preambulo do estudo fique so com o
% que e do estudo -- o `graphicspath`, o titulo e o resumo.
\RequirePackage{natbib}
\RequirePackage[hidelinks]{hyperref}

\ifterra@capa
  \RequirePackage{tikz}
  \RequirePackage{eso-pic}
  % Condensada pesada para a manchete da capa de periodico. A Nature usa
  % Knockout, que e comercial; Oswald Bold e o parente livre mais proximo --
  % grotesca condensada, caixa-alta fechada, que e o que faz manchete
  % sobreviver a fundo agitado com o mesmo contraste que tipo leve nao
  % sobrevive.
  %
  % O pacote troca \rmdefault e \sfdefault do documento inteiro por Oswald,
  % que nao e o que se quer: aqui ele e carregado so pela familia, e os
  % defaults voltam ao que o bloco tipografico acima escolheu.
  \let\terra@rmsalvo\rmdefault
  \let\terra@sfsalvo\sfdefault
  \let\terra@ttsalvo\ttdefault
  \RequirePackage{Oswald}
  \renewcommand{\rmdefault}{\terra@rmsalvo}
  \renewcommand{\sfdefault}{\terra@sfsalvo}
  \renewcommand{\ttdefault}{\terra@ttsalvo}
  \newcommand{\terracondensada}{\fontfamily{Zeroswald-TLF}\fontseries{b}\selectfont}
\fi

% --- cores -----------------------------------------------------------
% A PALETA, nomeada como veio. Quatro tons analogos, de um quase-preto
% esverdeado a um caqui dourado. Substituiu um esquema de azul, vermelho e
% verde: os tres papeis de ressalva se distinguiam por MATIZ, e passam a se
% distinguir por CLARIDADE, que e o que uma paleta monocromatica oferece.
%
% Medido sobre papel branco, para o piso de 4,5:1 que texto pede:
%
%   Black Glaze     #021017   19,28:1
%   Shadow Warrior  #1C2922   15,11:1
%   Waiouru         #4A4C33    8,85:1
%   Trim            #726D47    5,26:1
%
% E entre si, que e o que separa um filete do vizinho:
%
%   Shadow Warrior x Waiouru  1,71      Waiouru x Trim  1,68
%   Shadow Warrior x Trim     2,87
%
% Um filete e um bloco solido de 0,35 x 1,6 em, tamanho em que uma diferenca
% de claridade dessa ordem se le. Nao se le tao rapido quanto azul contra
% vermelho: essa e a troca que uma paleta analoga impoe, e nao um defeito da
% escolha dos tons dentro dela.
\definecolor{terrablackglaze}{HTML}{021017}
\definecolor{terrashadowwarrior}{HTML}{1C2922}
\definecolor{terrawaiouru}{HTML}{4A4C33}
\definecolor{terratrim}{HTML}{726D47}

% OS PAPEIS APONTAM PARA A PALETA, em vez de repetirem os valores. Trocar um
% tom passa a ser trocar uma linha, e nenhum documento cita hexadecimal.
%
% `destaque` carrega texto corrido -- rotulo de campo, termo em negrito -- e
% por isso fica com Waiouru: 8,85:1, praticamente o mesmo peso do azul que
% ocupava o papel (8,22:1), de modo que nada no corpo muda de legibilidade.
% `fechada` marca o que limita, e desce para o tom mais escuro. `aberta`
% marca o achado, e sobe para o mais claro.
\colorlet{destaque}{terrawaiouru}
\colorlet{fechada}{terrashadowwarrior}
\colorlet{aberta}{terratrim}

% O disco que a capa pinta sobre a foto. E o mesmo Black Glaze da paleta, e
% nao mais um quase-preto proprio.
%
% `scripts/verifica_capa.py` reconstroi esse escurecimento para medir o
% contraste, e guarda o valor em `DISCO`. Os dois tem de andar juntos: com
% valores diferentes o script mede uma capa que o leitor nunca ve, e passa
% sem acusar nada.
\colorlet{terradisco}{terrablackglaze}

% O creme do letreiro do brasao, e o verde-agua do subtitulo. Usados pela
% `\terracapa` -- a capa sem anatomia de periodico -- e nao pela
% `\terracapaperiodico`, que compoe em branco puro.
%
% Os demais tons amostrados do brasao sairam: ouro, ceu, aqua e tres verdes,
% nenhum deles citado por comando algum. Definicao que ninguem usa nao e
% paleta, e dois deles eram azuis que a troca acima existiu para tirar.
\definecolor{terrapapel}{HTML}{F0ECE0}
\definecolor{terrabroto}{HTML}{7FD6AE}
% Creme rebaixado sobre o disco. Existe porque a capa usava o mesmo tom em
% dois niveis diferentes da hierarquia -- subtitulo e afiliacao --, e cor que
% marca duas coisas distintas nao marca nenhuma. O guia de ilustracao da
% Nature pede tipo neutro e UMA cor de destaque; aqui o destaque fica com o
% subtitulo, e a afiliacao desce um tom dentro da mesma familia.
% Medido: 6,6:1 sobre o pior pixel de fundo sob a faixa, contra o piso de 4,5.
\colorlet{terrapapelfraco}{terrapapel!70!terradisco}

% Capitulo -- so existe quando a classe tem um (`report`, `book`). Os estudos
% da linha sao `article` e nao passam por aqui; o template de tese passa.
% O rotulo "CAPITULO 3" fica pequeno e em cor acima do titulo, em vez de um
% numero gigante ao lado: numero grande compete com o titulo e nao ajuda a
% navegar, que e a unica coisa que um rotulo de capitulo tem para fazer.
\@ifundefined{chapter}{}{%
  \titleformat{\chapter}[display]
    {\sffamily\bfseries}
    {\normalfont\sffamily\bfseries\fontsize{10}{12}\selectfont
     \color{destaque}\MakeUppercase{\chaptertitlename}\ \thechapter}
    {.4em}{\fontsize{21}{25}\selectfont}
  \titleformat{name=\chapter,numberless}[display]
    {\sffamily\bfseries}{}{0pt}{\fontsize{21}{25}\selectfont}
  \titlespacing*{\chapter}{0pt}{0pt}{1.7em}
  \titlespacing*{name=\chapter,numberless}{0pt}{0pt}{1.7em}
}

% --- marcacoes de texto ----------------------------------------------
\newcommand{\termo}[1]{\textbf{\textcolor{destaque}{#1}}}
\newcommand{\campo}[1]{\par\smallskip\noindent\textbf{\textcolor{destaque}{#1.}}\ }

% Aviso: interrompe a exposicao com uma ressalva pratica.
\newenvironment{aviso}
  {\par\medskip\noindent\begin{tabular}{@{}p{0.4em}@{\hspace{0.8em}}p{\dimexpr\linewidth-2.2em}@{}}
   \textcolor{destaque}{\rule{0.35em}{1.6em}} &}
  {\end{tabular}\par\medskip}

% Objecao: o que derruba, limita ou contradiz o que se acabou de afirmar.
\newenvironment{objecao}
  {\par\medskip\noindent\begin{tabular}{@{}p{0.4em}@{\hspace{0.8em}}p{\dimexpr\linewidth-2.2em}@{}}
   \textcolor{fechada}{\rule{0.35em}{1.6em}} &}
  {\end{tabular}\par\medskip}

% Achado: o resultado que o documento existe para comunicar.
\newenvironment{achado}
  {\par\medskip\noindent\begin{tabular}{@{}p{0.4em}@{\hspace{0.8em}}p{\dimexpr\linewidth-2.2em}@{}}
   \textcolor{aberta}{\rule{0.35em}{1.6em}} &}
  {\end{tabular}\par\medskip}

% --- documento cientifico --------------------------------------------
% Tudo daqui para baixo e comando NOVO. Nada e redefinido: os estudos ja
% escritos usam o `abstract` da classe `article` e continuam usando -- por
% isso o resumo daqui se chama `resumo`, e nao `abstract`.

% Resumo, com rotulo opcional para a versao em outra lingua:
%   \begin{resumo} ... \end{resumo}
%   \begin{resumo}[Abstract] ... \end{resumo}
\newenvironment{resumo}[1][Resumo]
  {\par\medskip\small
   \begin{list}{}{%
     \setlength{\leftmargin}{1.4em}\setlength{\rightmargin}{1.4em}%
     \setlength{\listparindent}{0pt}\setlength{\parsep}{.4em}}%
   \item\relax
   {\sffamily\bfseries\color{destaque}\MakeUppercase{#1}}\par\smallskip
   \noindent\ignorespaces}
  {\end{list}\medskip}

\newcommand{\palavraschave}[1]{%
  \par\smallskip\noindent{\small
  \textbf{\textcolor{destaque}{Palavras-chave.}}\ #1}\par\medskip}
\newcommand{\keywords}[1]{%
  \par\smallskip\noindent{\small
  \textbf{\textcolor{destaque}{Keywords.}}\ #1}\par\medskip}

% Ficha de procedencia: de onde veio o dado, que periodo cobre, onde esta o
% codigo. Fica no inicio, e nao enterrada no metodo, porque "com que dado?"
% e a primeira pergunta de quem le -- e a unica que decide se vale ler o resto.
%
%   \begin{ficha}
%     \item[Dados] Sentinel-2 L2A, ...
%   \end{ficha}
\newlist{ficha}{description}{1}
\setlist[ficha]{font=\normalfont\sffamily\bfseries\color{destaque},
                style=multiline,leftmargin=3.4cm,labelwidth=3.1cm,
                topsep=.7em,itemsep=.35em,parsep=0pt}

% Lista de siglas da tese. Mesma forma da ficha, rotulo mais estreito.
\newlist{siglas}{description}{1}
\setlist[siglas]{font=\normalfont\sffamily\bfseries\color{destaque},
                 style=multiline,leftmargin=2.6cm,labelwidth=2.3cm,
                 topsep=.7em,itemsep=.25em,parsep=0pt}

% Figura de uma linha so, que e o formato de 90% delas:
%   \terrafig{curva.pdf}{O que se le no grafico.}{fig:curva}
%   \terrafig[.72\linewidth]{mapa.pdf}{...}{fig:mapa}
\newcommand{\terrafig}[4][\linewidth]{%
  \begin{figure}[htbp]\centering
    \includegraphics[width=#1]{#2}%
    \caption{#3}\label{#4}
  \end{figure}}

\captionsetup{font=small,labelfont=bf,width=.94\linewidth}

