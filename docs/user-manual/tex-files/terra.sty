% \terracapa{titulo}{subtitulo}{data}
%
% Foto em sangria total, escurecida por igual, texto por cima. Nada mais.
% Nem selo, nem brasao, nem filete: a capa de um documento de pesquisa nao
% precisa se apresentar duas vezes, e o titulo ja diz o que ele e.
\newcommand{\terracapa}[3]{%
  \begingroup
  \thispagestyle{empty}%
  \AddToShipoutPictureBG*{%
    \AtPageLowerLeft{%
      % A imagem ja vem na proporcao do A4, recortada por `prepara_capa.py`.
      % Por isso este `width`+`height` nao deforma nada: os dois valores batem
      % com a razao do arquivo. Passar aqui uma foto crua, de qualquer outra
      % proporcao, estica -- prepare antes.
      \includegraphics[width=\paperwidth,height=\paperheight]%
        {\terracapaimagem}}%
    \AtPageLowerLeft{%
      \begin{tikzpicture}[remember picture,overlay]
        % Uma cor so, opacidade uniforme, pagina inteira. Gradiente aqui vira
        % faixa visivel e chama atencao para si em vez de para o titulo.
        \fill[terradisco,opacity=\terracapaescuro]
          (0,0) rectangle (\paperwidth,\paperheight);
        % A faixa vai por cima do escurecimento e por baixo do texto.
        \ifx\terracapafaixa\empty\else
          \fill[terradisco,opacity=\terracapafaixa]
            (0,\paperheight-\terracapafaixatopo-\terracapafaixaalt)
            rectangle (\paperwidth,\paperheight-\terracapafaixatopo);
        \fi
        % O texto vai no TikZ, em coordenada absoluta da folha, e nao no fluxo
        % da pagina. No fluxo ele somava a margem do `geometry`: mudar a margem
        % do corpo deslocava a capa junto, que e acoplamento sem motivo -- capa
        % e miolo nao tem por que compartilhar medida.
        \node[anchor=north west,inner sep=0,text width=\terracapalargura,
              align=left] at (\terracapamargem,\paperheight-\terracapaalto) {%
          \ifx\terraversao\empty\else
            {\sffamily\fontsize{10}{13}\selectfont\bfseries
             \color{terrabroto}\terraversao
             \ifx\terracodinome\empty\else
               \color{terrapapel}\,\textbullet\,\MakeUppercase{\terracodinome}%
             \fi}\\[.9em]
          \fi
          {\color{terrapapel}\fontsize{30}{35}\selectfont\bfseries #1}\\[.7em]
          {\color{terrabroto}\sffamily\fontsize{12}{16}\selectfont #2}\\[1.4em]
          \ifx\terraautores\empty\else
            {\color{terrapapel}\sffamily\fontsize{10.5}{14}\selectfont
             \terraautores}%
            \ifx\terraafiliacao\empty\\[1.2em]\else\\[.4em]\fi
          \fi
          \ifx\terraafiliacao\empty\else
            {\color{terrapapelfraco}\sffamily\fontsize{9}{12.5}\selectfont
             \terraafiliacao}\\[1.2em]
          \fi
          {\color{terrapapel}\sffamily\fontsize{9}{12}\selectfont #3}%
        };
      \end{tikzpicture}}%
  }%
  \null
  \newpage
  \endgroup
}

% \terracapaperiodico{manchete}{linha fina}{data}
%
% A anatomia de capa de periodico, medida nas capas que a propria Nature
% publica: chapeu e fio no topo, marca grande sobreposta a foto, manchete em
% caixa-alta condensada na parte de baixo, fio curto, linha fina em serifada,
% e um rodape de tres colunas sob um fio de margem a margem.
%
% Duas diferencas em relacao ao original, e as duas sao medidas:
%
%   1. A Nature nao escurece a foto. Nao escurece porque escolhe a foto e o
%      recorte para o tipo cair onde ela ja e escura -- folha verde sob "HEAT
%      STRESS", espaco preto sob "DEATH OF A STAR". `verifica_capa.py` mediu
%      as nove fotos de `images/` nas cinco zonas desta diagramacao: nenhuma
%      passa 4,5:1 com branco puro sem escurecimento, e a melhor ainda pede
%      0,41. Mosaico de satelite em falsa cor tem pixel quase branco em toda
%      parte. Entao o escurecimento fica, no minimo que a foto exigir.
%
%   2. Nao ha a linha girada de volume e ISSN na borda direita. Numera
%      periodico, e um documento de estudo nao e periodico.
%
% A manchete e uma CHAMADA de duas a quatro palavras, e nao o titulo. O titulo
% vai na linha fina, exatamente como "HEAT STRESS" chama e "Ectotherms show
% dangerous sensitivity to extreme temperatures" diz.
%
% A caixa e do autor, e nao forcada por `\MakeUppercase`: forcar quebrava o
% `\\` da manchete, e caixa e decisao de quem escreve a chamada.
%
% Nem `\MakeUppercase` nem `\raggedright` entram nos nos daqui. O `align=left`
% do TikZ ja alinha a esquerda e instala o proprio `\\`; o `\raggedright` da
% LaTeX faz `\let\\\@centercr` e derruba a quebra junto com o espaco anterior
% a ela. A hifenizacao sai por `\hyphenchar\font=-1`, que desliga na fonte --
% capa nenhuma da Nature hifeniza, nem manchete nem linha fina.
\newlength{\terra@colw}
\newcommand{\terracapaperiodico}[3]{%
  \begingroup
  \thispagestyle{empty}%
  % Largura da coluna do rodape, calculada da folha e nao escrita a mao: a
  % capa nao tem por que deixar de fechar em papel que nao seja A4.
  \setlength{\terra@colw}{\dimexpr(\paperwidth-3cm)/3\relax}%
  \AddToShipoutPictureBG*{%
    \AtPageLowerLeft{%
      \includegraphics[width=\paperwidth,height=\paperheight]%
        {\terracapaimagem}}%
    \AtPageLowerLeft{%
      \begin{tikzpicture}[remember picture,overlay,
                          every node/.style={inner sep=0,outer sep=0}]
        \fill[terradisco,opacity=\terracapaescuro]
          (0,0) rectangle (\paperwidth,\paperheight);
        % -- chapeu e fio do topo
        \ifx\terracapachapeu\empty\else
          \node[anchor=base west,white] at (1.5cm,\paperheight-1.30cm)
            {\rmfamily\bfseries\fontsize{9.5}{11}\selectfont\terracapachapeu};
          \node[anchor=base east,white] at (\paperwidth-1.5cm,\paperheight-1.30cm)
            {\rmfamily\bfseries\fontsize{9.5}{11}\selectfont #3};
        \fi
        \draw[white,line width=.5pt]
          (1.5cm,\paperheight-1.62cm) -- (\paperwidth-1.5cm,\paperheight-1.62cm);
        % -- a marca, sobreposta a foto, sem caixa e sem filete
        \node[anchor=base west,white] at (1.5cm,\paperheight-5.30cm)
          {\rmfamily\bfseries\fontsize{86}{86}\selectfont\terracapamarca};
        % -- a manchete
        \node[anchor=north west,white,align=left,
              text width=\dimexpr\paperwidth-3cm\relax]
             at (1.5cm,\paperheight-16.30cm)
          {\terracondensada\fontsize{68}{58}\selectfont
           % Espaco entre palavras aberto de proposito. Em caixa-alta
